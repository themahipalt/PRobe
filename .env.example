# Copy to .env and load before running inference.py, or export in the shell.
#
# OpenAI-compatible HTTP API (must work with the official `openai` Python client).
# Examples:
#   https://api.openai.com/v1
#   https://router.huggingface.co/v1   (check current HF inference router docs)
API_BASE_URL=https://api.openai.com/v1

# Model id passed to chat.completions.create(model=...)
MODEL_NAME=gpt-4o-mini

# API key for the provider above (HF / OpenAI / other — name is fixed for the hackathon rubric)
HF_TOKEN=
